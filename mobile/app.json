{
  "expo": {
    "name": "timeHelper",
    "slug": "timehelper",
    "scheme": "timehelper",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.lucianokutger.timehelper",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Erlaube timeHelper den Zugriff auf das Mikrofon.",
          "speechRecognitionPermission": "Erlaube timeHelper die Umwandlung von Sprache in Text."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7440f70b-5fab-46fc-ba26-7b7703f8a35c"
      }
    }
  }
}
